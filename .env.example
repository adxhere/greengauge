# Copy this file to .env (same folder) and fill it in. Never commit .env: it holds your bot token.
# 1. On Telegram, message @BotFather, send /newbot, and copy the token it gives you.
# 2. From the supervisor's phone, send your new bot any message.
# 3. Run: python tools/telegram_chat_id.py YOUR_TOKEN   and copy the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: link added to each alert (e.g. your Vercel URL)
DASHBOARD_URL=
